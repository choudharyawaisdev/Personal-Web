# Apache Rewrite Rules for Portfolio Website
# Enables clean, extensionless URLs and SEO-friendly blog paths

Options -MultiViews
RewriteEngine On
RewriteBase /

# Redirect direct .php requests (GET/HEAD only, excluding admin) to extensionless URLs
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{REQUEST_URI} !/admin/ [NC]
RewriteCond %{THE_REQUEST} \s/+([^.\s]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Redirect /index or /index.php to root /
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} \s/+index(\.php)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# Clean SEO Friendly URLs for blog posts: /blog/post-slug -> /blog.php?slug=post-slug
RewriteRule ^blog/([a-zA-Z0-9\-]+)/?$ blog.php?slug=$1 [QSA,L]

# Resolve extensionless requests internally (e.g. /about -> /about.php)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^/]+)/?$ $1.php [L]
